# ERROREX Environment Configuration Template
# (Do NOT commit real secret values to version control)

# AI Studio runtime host
APP_URL="https://your-domain.com"
PORT=3000

# Firebase Web App Configuration (loaded automatically from firebase-applet-config.json)
# If deploying outside AI Studio, populate these environment variables:
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_DATABASE_ID="your-firestore-database-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
